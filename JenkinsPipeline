
pipeline {
    agent {
        label 'docker-agent'
    }

    environment {
        AWS_REGION = 'ap-south-2'
        ECR_REPO   = '641134884964.dkr.ecr.ap-south-2.amazonaws.com/bankapp'
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/naveenkumarg3729-coder/jenkins-automation.git'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build -t bankapp:${IMAGE_TAG} .'
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION | \
                docker login --username AWS --password-stdin \
                641134884964.dkr.ecr.ap-south-2.amazonaws.com
                '''
            }
        }

        stage('Tag Image') {
            steps {
                sh '''
                docker tag bankapp:${IMAGE_TAG} \
                $ECR_REPO:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                docker push $ECR_REPO:${IMAGE_TAG}
                '''
            }
        }
    }
}
