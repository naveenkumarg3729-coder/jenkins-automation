pipeline {
    agent {
        label 'docker-agent'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/naveenkumarg3729-coder/jenkins-automation.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t bankapp:v1 .'
            }
        }

        stage('Verify Image') {
            steps {
                sh 'docker images'
            }
        }
    }
}
