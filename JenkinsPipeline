
pipeline {
    agent {
        label 'docker-agent'
    }

    environment {
        ACCOUNT_ID = '641134884964'
        REGION = 'ap-south-2'
        REPOSITORY = 'bankapp'
        IMAGE_TAG = "${BUILD_NUMBER}"
        REGISTRY = "${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/naveenkumarg3729-coder/jenkins-automation.git'
            }
        }

        stage('Build Image') {
            steps {
                sh """
                docker build -t ${REPOSITORY}:${IMAGE_TAG} .
                """
            }
        }

        stage('ECR Login') {
            steps {
                sh """
                aws ecr get-login-password --region ${REGION} | \
                docker login --username AWS --password-stdin ${REGISTRY}
                """
            }
        }

        stage('Tag Image') {
            steps {
                sh """
                docker tag ${REPOSITORY}:${IMAGE_TAG} \
                ${REGISTRY}/${REPOSITORY}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Image') {
            steps {
                sh """
                docker push ${REGISTRY}/${REPOSITORY}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy Container') {
            steps {
                sh """
                docker rm -f bankapp-container || true

                docker run -d \
                --name bankapp-container \
                -p 8080:80 \
                ${REGISTRY}/${REPOSITORY}:${IMAGE_TAG}
                """
            }
        }

        stage('Verify') {
            steps {
                sh '''
                docker ps
                '''
            }
        }
    }
}
