pipeline {
    agent {
        label 'docker-agent'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/naveenkumarg3729-coder/jenkins-automation.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t bankapp:v1 .'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh '''
                docker rm -f bankapp-container || true
                '''
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker run -d \
                --name bankapp-container \
                -p 8080:80 \
                bankapp:v1
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'docker ps'
                sh 'docker images'
            }
        }
    }
}
